<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FixIt.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/grahak_black</item>
        <item name="android:statusBarColor">@color/grahak_black</item>
        <item name="android:navigationBarColor">@color/grahak_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Prevent Android 12+ default launcher icon flash on splash screen -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash_icon</item>
        <item name="android:windowSplashScreenBackground">@color/grahak_black</item>
    </style>
</resources>
